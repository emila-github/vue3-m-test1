# ===== 通用环境变量（所有环境生效） =====
VITE_APP_TITLE=Vue3 Demo
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# ===== 全站无感知操作记录（track 插件）=====
# 默认开启；设为 false 关闭（'false' / '0' / 'no' 均视为关闭）。
# 业务仍可在运行时调用 track.disable() / track.enable() 动态控制。
VITE_TRACK_ENABLED=true

# ===== ydl 站点（旧站 / 源平台）后端 =====
# is 根路径：业务/登录/权限/验证码等（siteClient，baseURL = VITE_SITE_API_BASE_URL）
# wx 根路径：企业微信鉴权（/cp/wxAuth/...，siteWxClient，baseURL = VITE_SITE_WX_API_BASE_URL）
# mock 用相对前缀（/site-api、/wx-api）；联调用真实地址（.../is、.../wx）。
VITE_SITE_API_BASE_URL=http://127.0.0.1:3000/site-api
VITE_SITE_WX_API_BASE_URL=http://127.0.0.1:3000/wx-api
VITE_YDL_API_BASE_URL=http://127.0.0.1:3000/ydl-api
# 企业微信 AppId（旧站 WX_APP_ID），联调时填真实值
VITE_SITE_WX_APP_ID=cf1ecb48-4521-46b5-a0b4-eb90013fe42c

# 腾讯地图 Key（JavaScript API GL 类型）；留空则打卡组件降级为纯坐标展示
VITE_TMAP_KEY=DNIBZ-4HBWS-EAZO2-6XP3E-BUBSF-N7FNW

# ===== 微信（微信开放平台 - 网站应用，需开通「微信登录」）=====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 企业微信（需在企业微信管理后台创建「网页应用」）=====
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=

# 授权回调基础地址（可选）
# 默认取请求来源（如 http://localhost:5173），仅当部署在反代 / 非 localhost 时填写，
# 且必须与微信 / 企业微信后台登记的回调域名一致：
# ↓↓↓ cpolar 内网穿透域名（企业微信 OAuth 回调必须走公网 HTTPS 可信域名）↓↓↓
# 注意：Vite 只会把「VITE_」开头的变量注入 import.meta.env（客户端可读）；
# 服务端 mock（Node）用无前缀的 OAUTH_REDIRECT_BASE，客户端（ydl composable）用 VITE_ 前缀版本。
OAUTH_REDIRECT_BASE=http://556f6148.r32.cpolar.top
VITE_OAUTH_REDIRECT_BASE=http://556f6148.r32.cpolar.top

# 是否在无凭证时启用「演示降级」（默认 true；设为 false 则无凭证时直接报错）
# OAUTH_DEV_FALLBACK=true

# ===== 登录 token 配置 =====
# 请求头中携带 token 的字段名（默认 X-Access-Token，可改为 Authorization 等）
VITE_TOKEN_HEADER=X-Access-Token
# token 在浏览器本地存储的 key（默认 app_token）
VITE_TOKEN_STORAGE_KEY=app_token

# ===== 开发调试：仅 /cp 走 mock / 预置 token =====
# 把「站点鉴权链路」强制走本地 mock：站点微信鉴权（/cp/wxAuth/...，siteWxClient）
# 与站点登录/权限/登出（/sys/...，siteClient）整体走 mock，避免 mock 登录换来的 token
# 与真实后端权限接口对不上而报「认证失败」。vant 业务接口（/api）仍走真实后端。
# 用于「开发环境 /cp 无后端、但其他接口正常」的场景，无需切换启动命令。
# 与纯 mock 模式（--mode mock，全部接口走 mock）不同。
# 注意：仅当真实后端确实没有提供 /cp 接口时才开启，否则会遮蔽真实鉴权。
# VITE_MOCK_CP=true
# 预置一个 token 写入本地存储（key 为 VITE_TOKEN_STORAGE_KEY），使后续请求自动携带、
# 跳过登录流程；填真实后端签发的 token 可直接联调受保护接口。仅开发用，生产请勿配置。
# VITE_DEV_TOKEN=


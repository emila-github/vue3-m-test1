# ===== 开发环境 =====
VITE_APP_TITLE=Vue3 Demo (DEV)
VITE_API_BASE_URL=http://40.33.32.20:8090/is

VITE_SITE_API_BASE_URL=http://40.33.32.20:8090/is
VITE_SITE_WX_API_BASE_URL=http://40.33.32.20:8090/wx

VITE_OAUTH_REDIRECT_BASE=http://556f6148.r32.cpolar.top

# ===== 全站无感知操作记录（track 插件）=====
# 默认开启；设为 false 关闭（'false' / '0' / 'no' 均视为关闭）。
# 业务仍可在运行时调用 track.disable() / track.enable() 动态控制。
VITE_TRACK_ENABLED=true

# ===== /cp 无后端时：站点鉴权链路走 mock + 预置 token（免登录联调） =====
# 站点微信鉴权（/cp/wxAuth/...）与站点登录/权限/登出（/sys/...）整体走本地 mock，
# 避免 mock 登录换 token 与真实后端权限接口对不上；vant 业务（/api）仍走上面真实后端。
VITE_MOCK_CP=true
# 预置 token（后续请求自动携带，跳过登录）；mock 下值任意，真实联调请替换为后端签发的 token
VITE_DEV_TOKEN=dev_mock_token_please_replace
# ===== 开发环境 =====
VITE_APP_TITLE=Vue3 Dev zyn
VITE_API_BASE_URL=http://40.33.32.20:8090/is

VITE_SITE_API_BASE_URL=http://40.33.32.20:8090/is
VITE_SITE_WX_API_BASE_URL=http://40.33.32.20:8090/wx
# ydl 业务模块（续保/保险来源等，ydlClient，baseURL 默认 /ydl-api）；联调真实后端同 host 前缀 /is
VITE_YDL_API_BASE_URL=http://40.33.32.20:8090/is

OAUTH_REDIRECT_BASE=
VITE_OAUTH_REDIRECT_BASE=
OAUTH_DEV_FALLBACK=true

# ===== 全站无感知操作记录（track 插件）=====
# 默认开启；设为 false 关闭（'false' / '0' / 'no' 均视为关闭）。
# 业务仍可在运行时调用 track.disable() / track.enable() 动态控制。
VITE_TRACK_ENABLED=true

# ===== 预置 token（免登录联调真实后端） =====
# 应用启动时预置一个真实 token 写入本地存储，使后续请求（含 /is、/wx、/api、/ydl-api）自动携带、
# 跳过登录流程。zyn 为纯真实后端模式（不开启 VITE_MOCK_CP，否则会禁用 proxy 导致请求打不到后端）。
# VITE_MOCK_CP=true
VITE_DEV_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJleHAiOjE3ODQ3OTM5OTQsInVzZXJuYW1lIjoiYWRtaW4ifQ.19UhFKWHZEMHKE3gqrNTLdKWux_vNetzCjlOG2TK3Eg


# ============================================================
# 真实打通微信 / 企业微信登录所需配置（mock 模式下由 node 端读取，不会下发到浏览器）
# 复制本文件为 .env 并填入真实凭证即可；不配置则自动进入「演示降级」模式（返回模拟用户信息）。
# ============================================================

# ===== 微信（微信开放平台 - 网站应用，需开通「微信登录」）=====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 企业微信（需在企业微信管理后台创建「网页应用」）=====
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=

# 授权回调基础地址（可选）
# 默认取请求来源（如 http://localhost:5173），仅当部署在反代 / 非 localhost 时填写，
# 且必须与微信 / 企业微信后台登记的回调域名一致：
# OAUTH_REDIRECT_BASE=https://your-domain.com

# 是否在无凭证时启用「演示降级」（默认 true；设为 false 则无凭证时直接报错）
# OAUTH_DEV_FALLBACK=true

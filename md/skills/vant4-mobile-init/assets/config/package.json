    "dayjs": "^1.11.21",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.2",
    "jsencrypt": "^3.5.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "unplugin-vue-components": "^32.1.0",
    "vant": "^4.9.24",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.6",
    "vue-request": "^2.0.4",
